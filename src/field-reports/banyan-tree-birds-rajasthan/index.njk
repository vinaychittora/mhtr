{% macro observationCards(records, lang) %}
  <div class="observation-card-grid" role="list">
    {% for record in records %}
      <article class="observation-card{% if record.evidenceId %} has-evidence{% endif %}" role="listitem">
        <div class="observation-card-copy">
          <div class="observation-card-head">
            <div>
              <p class="observation-kicker">{% if record.evidenceId %}{% if lang == "hi" %}साक्ष्य सहित{% else %}Evidence linked{% endif %}{% elif record.evidenceUrl %}{% if lang == "hi" %}स्रोत लिंक{% else %}Source link{% endif %}{% else %}{% if lang == "hi" %}क्षेत्र अवलोकन{% else %}Field observation{% endif %}{% endif %}</p>
              <h4>{{ record.common }}</h4>
              <p class="scientific-name"><em>{{ record.scientific }}</em></p>
            </div>
            <span class="activity-chip">{% if lang == "hi" %}{{ record.periodHi }}{% else %}{{ record.periodEn }}{% endif %}</span>
          </div>
          <p class="observation-behavior">{% if lang == "hi" %}{{ record.behaviorHi }}{% else %}{{ record.behaviorEn }}{% endif %}</p>
          {% if not record.evidenceId and not record.evidenceUrl %}
            <p class="observation-evidence-note is-pending">
              {% if lang == "hi" %}
                सटीक मीडिया एसेट जोड़े जाने तक यह रिकॉर्ड केवल पाठ्य क्षेत्र-अवलोकन के रूप में रखा गया है।
              {% else %}
                Kept as a text field observation until an exact media asset is attached.
              {% endif %}
            </p>
          {% endif %}
        </div>

        <div class="observation-card-media">
          {% if record.evidenceId %}
            <a
              class="media-preview"
              href="https://macaulaylibrary.org/asset/{{ record.evidenceId }}"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="{{ record.common }} Macaulay Library record ML{{ record.evidenceId }}">
              <img
                src="https://cdn.download.ams.birds.cornell.edu/api/v2/asset/{{ record.evidenceId }}/480"
                alt="{{ record.common }} media preview from Macaulay Library"
                loading="lazy"
                decoding="async">
              <span class="media-type-badge">{{ record.evidenceKind | upper }}</span>
            </a>
            <a class="evidence-asset-link" href="https://macaulaylibrary.org/asset/{{ record.evidenceId }}" target="_blank" rel="noopener noreferrer">ML{{ record.evidenceId }}</a>
          {% else %}
            <div class="evidence-pending-box{% if record.evidenceUrl %} has-source-link{% endif %}">
              {% if record.evidenceUrl %}
                <a href="{{ record.evidenceUrl }}" target="_blank" rel="noopener noreferrer">
                  {% if lang == "hi" %}{{ record.evidenceLabelHi or record.evidenceLabel }}{% else %}{{ record.evidenceLabel }}{% endif %}
                </a>
                <span>{% if lang == "hi" %}Exact ML asset अभी confirm करना है{% else %}Exact ML asset still needs confirmation{% endif %}</span>
              {% else %}
                <span>{% if lang == "hi" %}सटीक Macaulay asset URL चाहिए{% else %}Exact Macaulay asset URL needed{% endif %}</span>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </article>
    {% endfor %}
  </div>
{% endmacro %}

