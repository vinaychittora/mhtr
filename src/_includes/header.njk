<header class="site-header">
  <div class="nav">
    <div class="brand">
      <a href="/" class="brand-title">Mukundara Hills Tiger Reserve</a>
      <span class="muted">Independent information & resources (MHTR)</span>
    </div>

    <nav aria-label="Primary">
      <ul>
        {% for item in nav %}
          <li>
            <a href="{{ item.href }}" {% if page.url == item.match %}aria-current="page"{% endif %}>{{ item.label }}</a>
          </li>
        {% endfor %}
      </ul>
    </nav>
  </div>
</header>
