<!doctype html>
<html lang="{{ lang or 'en-IN' }}">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#123d32" />

  {% set pageTitle = title or site.title %}
  {% set pageDescription = description or site.description %}
  {% set pageImage = og_image or site.ogImage %}
  {% set pageImageAlt = og_image_alt or site.ogImageAlt %}
  {% set pageImageWidth = og_image_width or site.ogImageWidth %}
  {% set pageImageHeight = og_image_height or site.ogImageHeight %}
  {% set pageCanonical = canonical or (site.url + page.url) %}
  {% set pageLang = lang or 'en-IN' %}
  {% set pageSchemaType = schema_type or 'WebPage' %}

  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}" />
  {% if keywords %}<meta name="keywords" content="{{ keywords }}" />{% endif %}
  <meta name="robots" content="{{ robots or 'index,follow' }}" />
  <meta name="application-name" content="MHTR" />
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  <meta name="format-detection" content="telephone=no" />
  {% if author %}<meta name="author" content="{{ author }}" />{% endif %}

  <link rel="canonical" href="{{ pageCanonical }}" />
  {% if preload_image %}<link rel="preload" as="image" href="{{ preload_image }}" fetchpriority="high" />{% endif %}
  <link rel="icon" href="/assets/imgs/mhtr-logo.svg" type="image/svg+xml" />
  <link rel="icon" href="/assets/imgs/mhtr-favicon-48.png" type="image/png" sizes="48x48" />
  <link rel="apple-touch-icon" href="/assets/imgs/mhtr-apple-touch-icon.png" />

  <meta property="og:type" content="{{ og_type or 'website' }}" />
  <meta property="og:locale" content="en_IN" />
  <meta property="og:site_name" content="{{ site.title }}" />
  <meta property="og:title" content="{{ og_title or pageTitle }}" />
  <meta property="og:description" content="{{ og_description or pageDescription }}" />
  <meta property="og:url" content="{{ pageCanonical }}" />
  <meta property="og:image" content="{{ pageImage }}" />
  {% if pageImageAlt %}<meta property="og:image:alt" content="{{ pageImageAlt }}" />{% endif %}
  {% if pageImageWidth %}<meta property="og:image:width" content="{{ pageImageWidth }}" />{% endif %}
  {% if pageImageHeight %}<meta property="og:image:height" content="{{ pageImageHeight }}" />{% endif %}
  {% if publishedTime %}<meta property="article:published_time" content="{{ publishedTime }}" />{% endif %}
  {% if modifiedTime %}<meta property="article:modified_time" content="{{ modifiedTime }}" />{% endif %}
  {% if author %}<meta property="article:author" content="{{ author }}" />{% endif %}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ og_title or pageTitle }}" />
  <meta name="twitter:description" content="{{ og_description or pageDescription }}" />
  <meta name="twitter:image" content="{{ pageImage }}" />
  {% if pageImageAlt %}<meta name="twitter:image:alt" content="{{ pageImageAlt }}" />{% endif %}
  <meta name="twitter:url" content="{{ pageCanonical }}" />

  <link rel="stylesheet" href="/assets/css/style.css">
  <script src="/assets/js/main.js" defer></script>

  <script type="application/ld+json">
  [
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": "{{ site.url }}#website",
      "name": "MHTR",
      "alternateName": [
        "Mukundara Hills Tiger Reserve",
        "Mukundra Hills Tiger Reserve",
        "Mukandra Hills Tiger Reserve"
      ],
      "url": "{{ site.url }}",
      "description": "{{ site.description | safe }}",
      "inLanguage": "{{ pageLang }}"
    },
    {
      "@context": "https://schema.org",
      "@type": "{{ pageSchemaType }}",
      "@id": "{{ pageCanonical }}#webpage",
      "url": "{{ pageCanonical }}",
      "name": "{{ pageTitle | safe }}",
      "description": "{{ pageDescription | safe }}",
      "isPartOf": {
        "@id": "{{ site.url }}#website"
      },
      "inLanguage": "{{ pageLang }}",
      "primaryImageOfPage": {
        "@type": "ImageObject",
        "url": "{{ pageImage }}"{% if pageImageAlt %},
        "caption": "{{ pageImageAlt }}"{% endif %}
      }
    }
  ]
  </script>
</head>

<body>
  <a class="skip-link" href="#main">Skip to main content</a>
  {% include "header.njk" %}

  <main class="wrap" id="main" tabindex="-1">
    {{ content | safe }}
  </main>

  {% include "footer.njk" %}

  <script>
    const y = document.getElementById("y");
    if (y) y.textContent = new Date().getFullYear();
  </script>
</body>
</html>
