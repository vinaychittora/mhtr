---
layout: base.njk
activeSection: resources
pagination:
  data: resourceDocuments
  size: 1
  alias: doc
permalink: "/resources/documents/{{ doc.slug }}/"
eleventyComputed:
  title: "{{ doc.seoTitle or doc.title }} | MHTR Archive"
  description: "{{ doc.summary }}"
  keywords: "{{ doc.title }}, {{ doc.source }}, {{ doc.category }}, Mukundara Hills Tiger Reserve, MHTR resource archive"
  og_title: "{{ doc.title }}"
  og_description: "{{ doc.summary }}"
  og_image: "https://mhtr.in/assets/imgs/mhtr-resources.png"
  og_image_alt: "Collection of MHTR research and policy documents."
  og_image_width: 1475
  og_image_height: 1015
  schema_type: WebPage
---

{% set archiveUrl = doc.localPath | archiveDocumentUrl %}
{% set archiveAvailable = not doc.sourceOnly and (deployment.docsArchiveBaseUrl or deployment.target != "cloudflare-pages" or not doc.cloudflarePagesOmitLocal) %}
{% set archiveIsExternal = deployment.docsArchiveBaseUrl %}

<article class="document-page">
  <header class="page-hero document-hero">
    <p class="eyebrow">Resource Archive / {{ doc.category }}</p>
    <h1>{{ doc.title }}</h1>
    <p class="lede">{{ doc.summary }}</p>
    <div class="document-actions">
{% if archiveAvailable %}
      <a class="button-link" href="{{ archiveUrl }}" target="_blank" rel="noopener">Open archived PDF</a>
      <a class="button-link button-link-secondary" href="{{ doc.sourceUrl }}" target="_blank" rel="noopener noreferrer">Original source</a>
{% else %}
      <a class="button-link" href="{{ doc.sourceUrl }}" target="_blank" rel="noopener noreferrer">Open original source</a>
{% endif %}
      <a class="button-link button-link-secondary" href="/resources/">All resources</a>
    </div>
  </header>

  <section class="document-meta-grid" aria-label="Document metadata">
    <div class="aside-box">
      <h2>Archive Metadata</h2>
      <p><strong>Source:</strong> {{ doc.source }}</p>
      <p><strong>Type:</strong> {{ doc.type }}</p>
      <p><strong>Issued:</strong> {{ doc.issued }}</p>
{% if archiveAvailable and archiveIsExternal %}
      <p><strong>Archive status:</strong> Stored in the MHTR document archive; original source retained for citation.</p>
{% elif archiveAvailable %}
      <p><strong>Archived locally:</strong> {{ doc.archivedAt }}</p>
{% else %}
      <p><strong>Access:</strong> Original publisher link. This source is indexed here without republishing the file.</p>
{% endif %}
      <p><strong>File:</strong> {{ doc.fileSize }}{% if doc.pages %} / {{ doc.pages }} pages{% endif %}</p>
    </div>

    <div class="aside-box">
      <h2>Use This For</h2>
      <p>{{ doc.useFor }}</p>
      <p class="muted">{{ doc.researchNote }}</p>
    </div>
  </section>

{% if archiveAvailable %}
  <section class="section" aria-label="Archived document viewer">
    <div class="pdf-toolbar">
      <p class="muted">
        The PDF below is an archive copy. Keep using the original source link for citation and version checking.
      </p>
      <a href="{{ archiveUrl }}" target="_blank" rel="noopener">Open in a new tab</a>
    </div>
    <iframe
      class="pdf-viewer"
      title="{{ doc.title }} PDF viewer"
      src="{{ archiveUrl }}"
      loading="lazy"></iframe>
  </section>
{% else %}
  <section class="section source-panel" aria-label="Original document source">
    <div>
      <p class="eyebrow">Publisher-hosted Record</p>
      <h2>Read the current copy from the original publisher</h2>
      <p>
        This catalogue page preserves searchable metadata and interpretation guidance while linking to the
        issuing authority's copy. Confirm the publisher, date and document version when citing it.
      </p>
    </div>
    <div class="source-actions">
      <a class="button-link" href="{{ doc.sourceUrl }}" target="_blank" rel="noopener noreferrer">Open original source</a>
    </div>
  </section>
{% endif %}

  <script type="application/ld+json">
  {% documentJsonLd site, page, doc, archiveAvailable, archiveUrl %}
  </script>
</article>
