<section class="section" id="map-library" aria-labelledby="map-library-heading">
  <div class="section-heading">
    <p class="eyebrow">High-resolution Maps</p>
    <h2 id="map-library-heading">Open any map in the zoom viewer</h2>
    <p class="muted">
      Select a map to open a full-screen viewer. Use the zoom buttons, drag the map, or scroll with a trackpad
      to inspect details.
    </p>
  </div>

  <div class="gis-map-grid">
{% for map in gisMaps %}
    <article class="gis-map-card" id="{{ map.slug }}">
      <button
        class="map-zoom-trigger"
        type="button"
        data-map-viewer
        data-map-title="{{ map.title }}"
        data-map-src="{{ map.image }}"
        data-map-alt="{{ map.alt }}">
        <img
          src="{{ map.preview or map.image }}"
          alt="{{ map.alt }}"
          width="{{ map.previewWidth or map.width }}"
          height="{{ map.previewHeight or map.height }}"
          loading="{% if loop.first %}eager{% else %}lazy{% endif %}"
          decoding="async">
        <span>Open zoom view</span>
      </button>
      <div class="gis-map-card-body">
        <p class="eyebrow">{{ map.shortTitle }}</p>
        <h3>{{ map.title }}</h3>
        <p>{{ map.summary }}</p>
        <p><strong>Use this for:</strong> {{ map.useFor }}</p>
        <p class="muted"><strong>Sources:</strong> {{ map.sources }}</p>
{% if map.sourceLinks %}
        <p class="muted"><strong>Evidence:</strong>
  {% for sourceLink in map.sourceLinks %}
          <a href="{{ sourceLink.url }}">{{ sourceLink.label }}</a>{% if not loop.last %}; {% endif %}
  {% endfor %}
        </p>
{% endif %}
      </div>
    </article>
{% endfor %}
  </div>
</section>

<section class="section source-panel" aria-labelledby="gis-source-heading">
  <div>
    <p class="eyebrow">Source and Safety Notes</p>
    <h2 id="gis-source-heading">Public maps, not sensitive field locations</h2>
    <p>
      The map stack uses the official MHTR ESZ outer-limit KML, Gazette and reserve notification records,
      together with OpenStreetMap, ESA WorldCover 2021, Mapzen/AWS Terrarium elevation tiles and
      geoBoundaries. Every raster is an interpretation aid; none should be treated as cadastral or legal
      survey demarcation. The land-cover layer is explicitly a 2021 baseline, not a current land-cover claim.
    </p>
  </div>
