      <div><span class="fact-icon fact-icon--school" aria-hidden="true"></span><em>School field day</em><strong>Up to 15</strong><span>students + school chaperones</span></div>
      <div><span class="fact-icon fact-icon--compass" aria-hidden="true"></span><em>Learning formats</em><strong>4</strong><span>guided, non-collecting</span></div>
      <div><span class="fact-icon fact-icon--home" aria-hidden="true"></span><em>Community</em><strong>Local</strong><span>hosting, food and guiding</span></div>
    </div>
  </section>

