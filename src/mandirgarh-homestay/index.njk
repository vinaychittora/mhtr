    <div class="trail-grid">
      <article class="trail-card">
        <img src="/mandirgarh-homestay/IMG_20250713_080038818~2.jpg" alt="हरी पत्तियों पर बैठी नारंगी और सफेद तितली" loading="lazy">
        <div><span class="trail-number">01</span><h3>वनस्पति एवं परागण भ्रमण</h3><p>मौसमी जंगली फूल, घास, झाड़ियाँ, तितलियाँ, मधुमक्खियाँ और इस शुष्क परिदृश्य के पारिस्थितिक संबंध देखें।</p><span class="trail-detail">उपयुक्त · प्रकृति प्रेमी, मैक्रो फोटोग्राफी, सहज भ्रमण</span></div>
      </article>
      <article class="trail-card">
        <img src="/mandirgarh-homestay/IMG_20251012_084333630.jpg" alt="मंदिरगढ़ में खेत और आर्द्रभूमि का किनारा" loading="lazy">
        <div><span class="trail-number">02</span><h3>आर्द्रभूमि एवं खुले क्षेत्र की ट्रेल</h3><p>स्थानीय और प्रवासी पक्षियों के लिए जलाशय, झाड़ियों और खेतों के किनारे चलें; अन्य वन्यजीवों के संकेत या दर्शन भी संभव हैं।</p><span class="trail-detail">उपयुक्त · पक्षी दर्शन, सूर्योदय भ्रमण, परिदृश्य अवलोकन</span></div>
      </article>
      <article class="trail-card">
        <img src="/mandirgarh-homestay/IMG_20250928_153942789.jpg" alt="मंदिरगढ़ के पास पेड़ों के बीच प्राचीन मंदिर अवशेष" loading="lazy">
        <div><span class="trail-number">03</span><h3>विरासत एवं ग्राम ट्रेल</h3><p>मंदिर अवशेष, पुराने जल स्थल, खेत और गाँव के बीच चलते हुए इतिहास, आजीविका और पारिस्थितिकी का संबंध जानें।</p><span class="trail-detail">उपयुक्त · विरासत, ग्रामीण परिदृश्य, स्थानीय कथाएँ</span></div>
